{# templates/contact/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Contact
{% endblock %}

{% block body %}
	<div class="contact row justify-content-center">
		<h5 class="text-center my-3">Contact</h5>
		{{ form_start(form, {'attr': {'class': 'contact-form border border-dark rounded m-2 col-9 col-md-6 pb-2'}}) }}
		<div class="contact-form-container container">
			<div class="m-md-2 text-center">
				{{ form_label(form.email, 'Adresse mail', {'label_attr': {'class': 'form-label'}}) }}
				{{ form_widget(form.email) }}
			</div>
			<div class="m-md-2 text-center">
				{{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
				{{ form_widget(form.title) }}
			</div>
			<div class="m-md-2 text-center">
				{{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
				{{ form_widget(form.description) }}
			</div>
			<div class="d-grid gap-2 m-2 col-3 mx-auto">
				<button type="submit" class="btn btn-primary text-center">Submit</button>
			</div>
		</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
